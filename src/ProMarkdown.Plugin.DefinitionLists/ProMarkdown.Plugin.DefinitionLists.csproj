<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ProMarkdown.Plugin.DefinitionLists</PackageId>
    <Title>ProMarkdown Definition Lists Plugin</Title>
    <Description>Definition list parsing, rendering, and editing support for ProMarkdown.</Description>
    <PackageTags>$(PackageTags);avalonia;markdown;plugin;definition-list</PackageTags>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProMarkdown\ProMarkdown.csproj" />
  </ItemGroup>
</Project>
