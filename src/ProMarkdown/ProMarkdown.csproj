<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ProMarkdown</PackageId>
    <Title>ProMarkdown</Title>
    <Description>Avalonia markdown rendering and editing primitives for conversation, diff, and document surfaces.</Description>
    <PackageTags>$(PackageTags);avalonia;markdown;markdig;editor</PackageTags>
  </PropertyGroup>


  <ItemGroup>
    <EmbeddedResource Include="Assets/FluentSystemIcons.LICENSE.txt" />
    <None Include="Assets/FluentSystemIcons.LICENSE.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
  </ItemGroup>
</Project>
