<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ProMarkdown.Plugin.Math</PackageId>
    <Title>ProMarkdown Math Plugin</Title>
    <Description>Math block and inline parsing, rendering, and editing support for ProMarkdown.</Description>
    <PackageTags>$(PackageTags);avalonia;markdown;plugin;math;latex</PackageTags>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProMarkdown\ProMarkdown.csproj" />
  </ItemGroup>
</Project>
