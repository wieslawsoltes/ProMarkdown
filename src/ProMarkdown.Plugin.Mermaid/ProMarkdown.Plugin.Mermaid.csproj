<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ProMarkdown.Plugin.Mermaid</PackageId>
    <Title>ProMarkdown Mermaid Plugin</Title>
    <Description>Mermaid diagram rendering support for ProMarkdown.</Description>
    <PackageTags>$(PackageTags);avalonia;markdown;plugin;mermaid;diagrams</PackageTags>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Mermaider" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProMarkdown\ProMarkdown.csproj" />
  </ItemGroup>
</Project>
