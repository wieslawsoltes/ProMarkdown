<Project>
  <Target Name="UsePatchedAvaloniaWin32ForNativeAot"
          AfterTargets="_ComputeIlcCompileInputs"
          Condition="'$(PublishAot)' == 'true' and '$(AvaloniaWin32AotAssembly)' != ''">
    <Error Condition="'$(TargetFramework)' != 'net11.0' or '$(RuntimeIdentifier)' != 'win-arm64'"
           Text="The patched Avalonia Win32 backend is validated only for net11.0/win-arm64." />
    <Error Condition="!Exists('$(AvaloniaWin32AotAssembly)')"
           Text="The patched Avalonia Win32 assembly does not exist: $(AvaloniaWin32AotAssembly)" />
    <ItemGroup>
      <_OriginalAvaloniaWin32 Include="@(IlcReference)" Condition="'%(Filename)' == 'Avalonia.Win32'" />
    </ItemGroup>
    <Error Condition="'@(_OriginalAvaloniaWin32->Count())' != '1'"
           Text="Expected exactly one Avalonia.Win32 Native AOT input." />
    <GetAssemblyIdentity AssemblyFiles="@(_OriginalAvaloniaWin32)">
      <Output TaskParameter="Assemblies" ItemName="_OriginalAvaloniaWin32Identity" />
    </GetAssemblyIdentity>
    <GetAssemblyIdentity AssemblyFiles="$(AvaloniaWin32AotAssembly)">
      <Output TaskParameter="Assemblies" ItemName="_PatchedAvaloniaWin32Identity" />
    </GetAssemblyIdentity>
    <Error Condition="'@(_OriginalAvaloniaWin32Identity)' != '@(_PatchedAvaloniaWin32Identity)'"
           Text="The patched Avalonia Win32 assembly identity must match the package assembly." />
    <ItemGroup>
      <IlcReference Remove="@(_OriginalAvaloniaWin32)" />
      <IlcReference Include="$(AvaloniaWin32AotAssembly)" />
    </ItemGroup>
    <Message Importance="high" Text="Native AOT uses the source-patched Avalonia Win32 backend: $(AvaloniaWin32AotAssembly)" />
  </Target>
</Project>
